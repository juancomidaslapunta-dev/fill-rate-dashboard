# Plantilla de variables de entorno necesarias para el backend.
# NO pongas valores reales aquí — este archivo SÍ se sube a GitHub como referencia.
# Los valores reales se configuran en Vercel → Project Settings → Environment Variables,
# y se generan automáticamente al conectar la integración de Upstash Redis
# (Vercel → tu proyecto → Storage → Marketplace → Upstash Redis → Connect).

# Inyectadas automáticamente por la integración de Upstash Redis en Vercel:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Alternativa si conectas Upstash manualmente en vez de vía integración de Vercel:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
